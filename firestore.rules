rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── YARDIMCI FONKSİYONLAR ───
    function isLoggedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isLoggedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ─── KULLANICILAR ───
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ─── PRESENCE (AKTIFLIK) ───
    match /presence/{userId} {
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    // ─── SEANSLAR ───
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
      allow read: if isAdmin();
    }

    // ─── GÜNLÜK AJANDA ───
    match /users/{userId}/agenda/{dateStr} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/agenda/{dateStr}/tasks/{taskId} {
      allow read, write: if isOwner(userId);
    }

    // ─── GÜNLÜK NOTLAR ───
    match /users/{userId}/notes/{noteId} {
      allow read, write: if isOwner(userId);
    }

    // ─── ADMİNLER ───
    match /admins/{adminId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn();
      allow delete: if isAdmin();
    }

    // ─── DESTEK TALEPLERİ ───
    match /support/{ticketId} {
      allow create: if isLoggedIn();
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow update: if isAdmin();
    }

    // ─── DUYURULAR ───
    match /announcements/{annId} {
      allow read: if isLoggedIn();
      allow write: if isAdmin();
    }

    // ─── ÖDEMELER ───
    match /payments/{paymentId} {
      allow read: if isAdmin();
    }

    // ─── BEKLEYEN ÖDEMELER ───
    match /pendingPayments/{tokenId} {
      allow read: if isLoggedIn();
    }
  }
}
